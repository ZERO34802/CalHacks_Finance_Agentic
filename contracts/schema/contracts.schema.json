{
  "$defs": {
    "Approval": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "case_id": {
          "type": "string"
        },
        "approver": {
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/Role"
        },
        "decision": {
          "$ref": "#/$defs/ApprovalDecision"
        },
        "comment": {
          "default": "",
          "type": "string"
        },
        "limit": {
          "anyOf": [
            {
              "description": "Decimal amount as string",
              "pattern": "^-?\\d+(\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "at": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "id",
        "case_id",
        "approver",
        "role",
        "decision",
        "comment",
        "limit",
        "at"
      ],
      "title": "Approval",
      "type": "object"
    },
    "ApprovalDecision": {
      "enum": [
        "approved",
        "rejected",
        "ask"
      ],
      "title": "ApprovalDecision",
      "type": "string"
    },
    "ApprovalRequest": {
      "additionalProperties": false,
      "properties": {
        "approver": {
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/Role"
        },
        "decision": {
          "$ref": "#/$defs/ApprovalDecision"
        },
        "comment": {
          "default": "",
          "type": "string"
        }
      },
      "required": [
        "approver",
        "role",
        "decision",
        "comment"
      ],
      "title": "ApprovalRequest",
      "type": "object"
    },
    "Case": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "parent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "vendor_id": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/CaseStatus"
        },
        "documents": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Document"
          },
          "type": "array"
        },
        "invoice": {
          "anyOf": [
            {
              "$ref": "#/$defs/Invoice"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "po": {
          "anyOf": [
            {
              "$ref": "#/$defs/PO"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "receipts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Receipt"
          },
          "type": "array"
        },
        "fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "links": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CaseLink"
          },
          "type": "array"
        },
        "quarantine_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "discrepancies": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Discrepancy"
          },
          "type": "array"
        },
        "skill": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "proposal": {
          "anyOf": [
            {
              "$ref": "#/$defs/Proposal"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "approvals": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Approval"
          },
          "type": "array"
        },
        "journal_entry": {
          "anyOf": [
            {
              "$ref": "#/$defs/JournalEntry"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "decision": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decision"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "replans": {
          "default": 0,
          "description": "Times the agent re-planned after a rejection",
          "type": "integer"
        },
        "as_of": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Business 'today' for this case (posting date, period locks)"
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "updated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "notes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "parent_id",
        "vendor_id",
        "status",
        "documents",
        "invoice",
        "po",
        "receipts",
        "fingerprint",
        "evidence_hash",
        "links",
        "quarantine_reason",
        "discrepancies",
        "skill",
        "proposal",
        "approvals",
        "journal_entry",
        "decision",
        "replans",
        "as_of",
        "created_at",
        "updated_at",
        "notes"
      ],
      "title": "Case",
      "type": "object"
    },
    "CaseDetail": {
      "additionalProperties": false,
      "properties": {
        "case": {
          "$ref": "#/$defs/Case"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/Step"
          },
          "type": "array"
        }
      },
      "required": [
        "case",
        "steps"
      ],
      "title": "CaseDetail",
      "type": "object"
    },
    "CaseFixture": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "inbound": {
          "items": {
            "$ref": "#/$defs/InboundItem"
          },
          "type": "array"
        },
        "as_of": {
          "description": "'Today' for this case (period locks, due dates)",
          "format": "date",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "inbound",
        "as_of"
      ],
      "title": "CaseFixture",
      "type": "object"
    },
    "CaseLink": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/$defs/CaseLinkType"
        },
        "case_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "invoice_no": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "case_id",
        "invoice_no",
        "reason"
      ],
      "title": "CaseLink",
      "type": "object"
    },
    "CaseLinkType": {
      "enum": [
        "duplicate_of",
        "attached_to",
        "corrected_by",
        "related_pattern",
        "sub_case_of"
      ],
      "title": "CaseLinkType",
      "type": "string"
    },
    "CaseStatus": {
      "enum": [
        "new",
        "in_progress",
        "awaiting_approval",
        "approved",
        "rejected",
        "escalated",
        "posted",
        "quarantined",
        "resolved"
      ],
      "title": "CaseStatus",
      "type": "string"
    },
    "Channel": {
      "enum": [
        "api",
        "email",
        "sftp",
        "s3",
        "erp",
        "upload"
      ],
      "title": "Channel",
      "type": "string"
    },
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "doc_id": {
          "type": "string"
        },
        "locator": {
          "description": "e.g. 'line 2', 'row 14', 'para 3'",
          "type": "string"
        },
        "quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "doc_id",
        "locator",
        "quote"
      ],
      "title": "Citation",
      "type": "object"
    },
    "ContractTerm": {
      "additionalProperties": false,
      "description": "Contract / amendment price. Amendment wins only from effective_from.",
      "properties": {
        "doc_id": {
          "type": "string"
        },
        "vendor_id": {
          "type": "string"
        },
        "sku": {
          "type": "string"
        },
        "unit_price": {
          "description": "Decimal amount as string",
          "pattern": "^-?\\d+(\\.\\d+)?$",
          "type": "string"
        },
        "currency": {
          "type": "string"
        },
        "effective_from": {
          "format": "date",
          "type": "string"
        }
      },
      "required": [
        "doc_id",
        "vendor_id",
        "sku",
        "unit_price",
        "currency",
        "effective_from"
      ],
      "title": "ContractTerm",
      "type": "object"
    },
    "Decision": {
      "enum": [
        "approve",
        "hold",
        "reject",
        "escalate"
      ],
      "title": "Decision",
      "type": "string"
    },
    "Discrepancy": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/$defs/DiscrepancyType"
        },
        "line_no": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sku": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "material": {
          "default": true,
          "type": "boolean"
        },
        "expected": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "actual": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "delta": {
          "anyOf": [
            {
              "description": "Decimal amount as string",
              "pattern": "^-?\\d+(\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "citations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "type": "array"
        },
        "original_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/DiscrepancyType"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "For below_materiality: the type it would have been (e.g. price_over)"
        },
        "fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Per-discrepancy case fingerprint (vendor+PO+inv+type+SKU)"
        }
      },
      "required": [
        "type",
        "line_no",
        "sku",
        "material",
        "expected",
        "actual",
        "delta",
        "citations",
        "original_type",
        "fingerprint"
      ],
      "title": "Discrepancy",
      "type": "object"
    },
    "DiscrepancyType": {
      "enum": [
        "qty_short",
        "price_over",
        "unapproved_freight",
        "fx_gap",
        "duplicate_invoice",
        "bank_change",
        "lookalike_domain",
        "embedded_instructions",
        "below_materiality",
        "currency_mismatch",
        "unknown_po",
        "missing_receipt",
        "total_mismatch",
        "over_limit",
        "locked_period"
      ],
      "title": "DiscrepancyType",
      "type": "string"
    },
    "DocKind": {
      "enum": [
        "invoice",
        "po",
        "receipt",
        "contract",
        "amendment",
        "email",
        "statement",
        "credit_note"
      ],
      "title": "DocKind",
      "type": "string"
    },
    "Document": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/DocKind"
        },
        "vendor_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "channel": {
          "$ref": "#/$defs/Channel"
        },
        "filename": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "mime": {
          "type": "string"
        },
        "received_at": {
          "format": "date-time",
          "type": "string"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Raw text. UNTRUSTED. Never sent to a prompt with tools."
        },
        "sender": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "kind",
        "vendor_id",
        "channel",
        "filename",
        "sha256",
        "mime",
        "received_at",
        "text",
        "sender"
      ],
      "title": "Document",
      "type": "object"
    },
    "Employee": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "bank_last4": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "email",
        "bank_last4"
      ],
      "title": "Employee",
      "type": "object"
    },
    "EvalResult": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "expected": {
          "$ref": "#/$defs/ExpectedOutcome"
        },
        "actual_decision": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decision"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "actual_discrepancies": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DiscrepancyType"
          },
          "type": "array"
        },
        "actual_skill": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "checks": {
          "additionalProperties": {
            "type": "boolean"
          },
          "description": "decision, discrepancies, skill, inv_* invariants",
          "type": "object"
        },
        "passed": {
          "type": "boolean"
        },
        "misses": {
          "description": "Human-readable reason per failed check",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "case_id",
        "run_id",
        "expected",
        "actual_decision",
        "actual_discrepancies",
        "actual_skill",
        "checks",
        "passed",
        "misses"
      ],
      "title": "EvalResult",
      "type": "object"
    },
    "Event": {
      "additionalProperties": false,
      "description": "Pushed over WS /events.",
      "properties": {
        "type": {
          "description": "step.started | step.finished | case.updated",
          "type": "string"
        },
        "case_id": {
          "type": "string"
        },
        "step": {
          "anyOf": [
            {
              "$ref": "#/$defs/Step"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "anyOf": [
            {
              "$ref": "#/$defs/CaseStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "at": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "type",
        "case_id",
        "step",
        "status",
        "at"
      ],
      "title": "Event",
      "type": "object"
    },
    "ExpectedOutcome": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "type": "string"
        },
        "decision": {
          "$ref": "#/$defs/Decision"
        },
        "discrepancies": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DiscrepancyType"
          },
          "type": "array"
        },
        "skill": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "quarantined": {
          "default": false,
          "type": "boolean"
        },
        "links": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CaseLinkType"
          },
          "type": "array"
        },
        "invoice_no": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Extraction check"
        },
        "total": {
          "anyOf": [
            {
              "description": "Decimal amount as string",
              "pattern": "^-?\\d+(\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Extraction check"
        },
        "currency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "variance": {
          "anyOf": [
            {
              "description": "Decimal amount as string",
              "pattern": "^-?\\d+(\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Expected disputed amount, to the cent"
        },
        "tags": {
          "description": "e.g. attack, onboarding, format:xlsx, channel:sftp",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "note": {
          "default": "",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "decision",
        "discrepancies",
        "skill",
        "quarantined",
        "links",
        "invoice_no",
        "total",
        "currency",
        "variance",
        "tags",
        "note"
      ],
      "title": "ExpectedOutcome",
      "type": "object"
    },
    "InboundItem": {
      "additionalProperties": false,
      "description": "One file as it arrived. Paths are relative to the case folder.",
      "properties": {
        "channel": {
          "$ref": "#/$defs/Channel"
        },
        "path": {
          "type": "string"
        },
        "sender": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Email From / SFTP account / API key owner"
        },
        "api_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "API channel only; simulated per-vendor key"
        },
        "received_at": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "channel",
        "path",
        "sender",
        "api_key",
        "received_at"
      ],
      "title": "InboundItem",
      "type": "object"
    },
    "Invoice": {
      "additionalProperties": false,
      "properties": {
        "doc_id": {
          "type": "string"
        },
        "vendor_id": {
          "type": "string"
        },
        "invoice_no": {
          "type": "string"
        },
        "invoice_date": {
          "format": "date",
          "type": "string"
        },
        "due_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "currency": {
          "type": "string"
        },
        "po_number": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "lines": {
          "items": {
            "$ref": "#/$defs/LineItem"
          },
          "type": "array"
        },
        "total": {
          "description": "Decimal amount as string",
          "pattern": "^-?\\d+(\\.\\d+)?$",
          "type": "string"
        },
        "bank_last4": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Bank account on the invoice, last 4 only"
        },
        "flags": {
          "description": "Reader flags, e.g. embedded_instructions",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "doc_id",
        "vendor_id",
        "invoice_no",
        "invoice_date",
        "due_date",
        "currency",
        "po_number",
        "lines",
        "total",
        "bank_last4",
        "flags"
      ],
      "title": "Invoice",
      "type": "object"
    },
