# Copy to .env at repo root. Never commit real keys.
ANTHROPIC_API_KEY=
FACTORY_API_KEY=
RECONAI_DB=.data/reconai.db

# Optional: use local SpacetimeDB instead of SQLite (run `make stdb-start` + `make stdb-publish` first)
# RECONAI_STORE=spacetime
# RECONAI_SPACETIME_URL=http://127.0.0.1:3000

# Reviewer chat (backend/review/chat.py): Claude when credentials resolve, else deterministic answers.
# RECONAI_CHAT=offline   # force the deterministic path
# Background runs: seconds to pause per pipeline step so a run is visible in the demo (0 = off).
RECONAI_DEMO_PACE=0.35

# CRS Credit API (vendor onboarding: business identity, Intelliscore+, public records, OFAC).
# Unset CRS_BASE_URL = simulated sandbox with fictional test businesses, labelled "simulated" in the UI.
# CRS_BASE_URL=
# CRS_USERNAME=
# CRS_PASSWORD=
# CRS_AUTH_HEADER=Authorization
# CRS_AUTH_SCHEME=Bearer
# CRS_TIMEOUT=15

# Email (Resend): supplier discrepancy emails + vendor onboarding confirmations. Without a key, kept in the outbox.
# Resend's test sender (onboarding@resend.dev) only delivers to your Resend account's own address, so set the
# redirect to it. The fixture vendors are fictional: their mail is never sent to their domains, only to the redirect.
# RESEND_API_KEY=
# RESEND_FROM=ReconAI AP <onboarding@resend.dev>
# RECONAI_EMAIL_REDIRECT=you@example.com

# Coinbase Developer Platform (portal.cdp.coinbase.com): release payment runs as USDC on Base Sepolia testnet.
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=
# CDP_WALLET_SECRET=
# COINBASE_NETWORK=base-sepolia
# COINBASE_USD_SCALE=0.000001     # testnet: USDC sent = bill USD x scale (USD 72,500 -> 0.0725 USDC)

# Slack bot (config/slack-manifest.yaml). Starts inside `make api` when both tokens are set.
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...
# RECONAI_SLACK_INTERNAL_USERS=   # optional: Slack user ids treated as Helix besides the person who runs /reconai negotiate
# RECONAI_APP_URL=http://localhost:5173
# RECONAI_MARKET_WEB=on           # live web-search market notes in negotiation coaching (off = code + tables only)
