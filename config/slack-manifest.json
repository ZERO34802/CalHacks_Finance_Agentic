{
  "display_information": {
    "name": "ReconAI",
    "description": "Helix Silicon AP agent - negotiation coach, contracts, onboarding, POs, receipts, invoices, approvals and payments",
    "background_color": "#0e6e76"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": {
      "display_name": "ReconAI",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/reconai",
        "description": "negotiate | contract | onboard | role | roles | shipped | receive | invoice | status | stop",
        "usage_hint": "negotiate Acme Probe Cards  |  role controller  |  shipped PO-9001 30  |  invoice PO-9001",
        "should_escape": false
      },
      {
        "command": "/recon",
        "description": "Ask ReconAI privately about the negotiation in this channel (only you see it)",
        "usage_hint": "is $21,800 a good price?",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "channels:history",
        "groups:history",
        "mpim:history",
        "im:history",
        "chat:write",
        "chat:write.public",
        "commands",
        "files:read",
        "files:write",
        "im:read",
        "im:write",
        "users:read",
        "users:read.email"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_mention",
        "message.channels",
        "message.groups",
        "message.mpim",
        "message.im"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}